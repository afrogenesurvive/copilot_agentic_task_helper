{
  "name": "dev-centre",
  "version": "0.4.3",
  "private": true,
  "description": "Dev Centre — desktop control plane for the frontdesk v2 stack and the local agent tooling: queues, logs, sessions, licences, and the MCP tools, from one macOS app",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "make:icon": "electron ../scripts/make-icon.mjs",
    "postinstall": "node ../scripts/patch-electron-app-name.mjs",
    "dist:mac": "electron-builder --mac",
    "dist:mac-dir": "electron-builder --mac dir"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.devcentre.app",
    "productName": "Dev Centre",
    "icon": "assets/icon.png",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../scripts",
        "to": "scripts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../shared",
        "to": "shared",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../mcp",
        "to": "mcp",
        "filter": [
          "**/*",
          "!**/node_modules/**"
        ]
      },
      {
        "from": "../webapp",
        "to": "webapp",
        "filter": [
          "**/*",
          "!**/node_modules/**"
        ]
      },
      {
        "from": "../electron/docs",
        "to": "electron/docs",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
